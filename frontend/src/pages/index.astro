---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import CompanyCard from '../components/CompanyCard.astro';
import CategoryIcon from '../components/icons/CategoryIcon.astro';
import { supabase } from '../lib/supabase';
import { isActivePremium, activePremiumPlan } from '../lib/premium';
import heroCheckmark from '../assets/hero-checkmark-riso.png';
import trustCheckmark from '../assets/trust-checkmark-riso.png';

const { data: companies, error } = await supabase
  .from('tools')
  .select('*, categories(name_pl, slug), premium_listings(id, plan, ends_at), affiliate_links(affiliate_url, disclosure_text, active)')
  .eq('status', 'approved')
  .order('created_at', { ascending: false });

if (error) console.error('Supabase error:', error);

const sorted = [...(companies ?? [])].sort((a, b) => {
  return (isActivePremium(b) ? 1 : 0) - (isActivePremium(a) ? 1 : 0);
});

// Wszystkie aktywne premium zawsze widoczne (bez limitu), uzupełnione
// najnowszymi zwykłymi wpisami do łącznie 12 pozycji na stronie głównej.
const premiumCount = sorted.filter(isActivePremium).length;
const displayed = sorted.slice(0, Math.max(premiumCount, 12));

const { data: categoryList } = await supabase
  .from('categories')
  .select('id, slug, name_pl')
  .order('sort_order');

const categoryCounts = new Map<string, number>();
for (const tool of companies ?? []) {
  if (!tool.category_id) continue;
  categoryCounts.set(tool.category_id, (categoryCounts.get(tool.category_id) ?? 0) + 1);
}

const categoryTiles = (categoryList ?? []).map(cat => ({
  ...cat,
  count: categoryCounts.get(cat.id) ?? 0,
}));

const categoryHoverBorder: Record<string, string> = {
  'Automatyzacja procesów': 'hover:border-violet-300',
  'Analityka i BI': 'hover:border-blue-300',
  'Finanse i księgowość': 'hover:border-emerald-300',
  'HR i rekrutacja': 'hover:border-orange-300',
  'Marketing i content': 'hover:border-pink-300',
  'Obsługa klienta': 'hover:border-teal-300',
  'Prawo i compliance': 'hover:border-amber-300',
  'Sprzedaż i CRM': 'hover:border-red-300',
  'Zarządzanie projektami': 'hover:border-gray-300',
  'Cyberbezpieczeństwo AI': 'hover:border-slate-300',
};

function pluralizeTools(n: number): string {
  if (n === 1) return 'narzędzie';
  if (n >= 2 && n <= 4) return 'narzędzia';
  return 'narzędzi';
}
---

<Layout
  title="Katalog narzędzi AI"
  description="Największy katalog narzędzi AI dla polskiego rynku. Znajdź aplikacje, SaaS i startupy sztucznej inteligencji — z opisami, kategoriami i informacją o cenach."
>
  <div class="min-h-screen bg-gray-50">

    <main class="mx-auto max-w-5xl px-4 py-12">

      <!-- Hero -->
      <section class="mb-16 grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-12">
        <div>
          <h1 class="text-4xl font-extrabold tracking-[-0.02em] text-gray-900 lg:text-[64px] lg:leading-[1.05]">
            Katalog narzędzi AI z tagami{' '}
            <span class="relative inline-block">
              <span class="relative z-10">RODO i AI Act</span>
              <span class="absolute inset-x-0 bottom-0.5 z-0 h-3 bg-accent" aria-hidden="true"></span>
            </span>
          </h1>
          <p class="mt-5 max-w-xl text-lg text-gray-500">
            Jako jedyni w Polsce oceniamy każde narzędzie pod kątem RODO i ryzyka wg unijnego AI Act — plus przejrzyste kategorie i ceny.
          </p>
          <a
            href="/narzedzia/"
            class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3.5 text-base font-semibold text-ink transition-opacity hover:opacity-90"
          >
            Przeglądaj katalog →
          </a>
        </div>

        <!-- Kolumna 1fr ≈ 402px przy max-w-5xl → 400px + 2x dla retina.
             Czysto dekoracyjne (znaczenie niesie h1), stąd alt="". -->
        <div class="hidden lg:block">
          <Image
            src={heroCheckmark}
            alt=""
            width={400}
            densities={[1, 2]}
            class="aspect-square w-full max-w-[400px] rounded-2xl"
          />
        </div>
      </section>

      <!-- Kategorie -->
      <section class="mb-12">
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-wide text-gray-400">
          Kategorie
        </h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {categoryTiles.map(cat => (
            <a
              href={`/kategoria/${cat.slug}/`}
              class={`flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition-all hover:shadow-md ${categoryHoverBorder[cat.name_pl] ?? 'hover:border-gray-300'}`}
            >
              <CategoryIcon category={cat.name_pl} size={40} />
              <div class="min-w-0">
                <p class="truncate font-semibold text-gray-900">{cat.name_pl}</p>
                <p class="text-sm text-gray-500">{cat.count} {pluralizeTools(cat.count)}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- Karty firm -->
      <section>
        <h2 class="mb-6 text-sm font-semibold uppercase tracking-wide text-gray-400">
          Najnowsze wpisy
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {displayed.map(tool => {
            const isPremium = isActivePremium(tool);
            const activeAffiliateLink = (tool.affiliate_links ?? []).find((link: any) => link.active);
            return (
              <CompanyCard
                name={tool.name}
                description={tool.description_pl ?? tool.tagline_pl ?? ''}
                category={tool.categories?.name_pl ?? ''}
                pricing={tool.pricing_model ?? 'free'}
                url={tool.website_url}
                slug={tool.slug}
                isPremium={isPremium}
                premiumPlan={activePremiumPlan(tool)}
                affiliateUrl={activeAffiliateLink?.affiliate_url}
                disclosureText={activeAffiliateLink?.disclosure_text}
                rodoCompliant={tool.rodo_compliant}
                euDataHosting={tool.eu_data_hosting}
                aiActRisk={tool.ai_act_risk}
                logoUrl={tool.logo_url}
                bestForPl={tool.best_for_pl}
              />
            );
          })}
        </div>
      </section>

    </main>

    <section class="w-full bg-ink py-14 text-center sm:py-16">
      <Image
        src={trustCheckmark}
        alt=""
        width={96}
        densities={[1, 2]}
        class="mx-auto mb-6 h-20 w-20 sm:h-24 sm:w-24"
      />
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Ponad {companies?.length ?? 0} narzędzi z tagami RODO i AI Act
      </h2>
      <a
        href="/narzedzia/"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-lg bg-accent px-6 py-3.5 text-base font-semibold text-ink transition-opacity hover:opacity-90"
      >
        Przeglądaj cały katalog →
      </a>
    </section>

    <footer class="border-t border-gray-200 py-8 text-center text-sm text-gray-400">
      © {new Date().getFullYear()} aifirmy.pl ·{' '}
      <a href="/polityka-prywatnosci" class="hover:text-gray-600 hover:underline">
        Polityka prywatności
      </a>
      <p class="mt-2 text-xs text-gray-400">
        Opisy narzędzi generowane są z pomocą AI i weryfikowane przez redakcję przed publikacją.
      </p>
    </footer>

  </div>
</Layout>
